# Cyber Guardians Mobile - Docker Environment Variables

# =====================================================
# مفاتيح AI Provider (اختيارية - يعمل Agent بدونها)
# =====================================================

# Gemini (المزود الافتراضي - مجاني 1500 طلب/يوم)
GEMINI_API_KEY=your-gemini-key

# Groq (سريع جداً - مجاني 30 طلب/دقيقة)
GROQ_API_KEY=your-groq-key

# HuggingFace (مجاني 1000 طلب/يوم)
HUGGINGFACE_API_KEY=your-hf-key

# OpenRouter (مجاني حسب الموديل)
OPENROUTER_API_KEY=your-openrouter-key

# =====================================================
# إعدادات Agent
# =====================================================

# المنفذ (الافتراضي: 3001)
AGENT_PORT=3001

# المصادقة (اختياري - اتركه فارغاً لل开发)
AGENT_TOKEN=

# الإعدادات: minimal | full | education
AGENT_PROFILE=full

# السجلات التفصيلية
AGENT_VERBOSE=false

# =====================================================
# إعدادات Frontend
# =====================================================

# رابط WebSocket للاتصال بالAgent
VITE_AGENT_URL=ws://localhost:3001

# رابط API للاتصال بالAgent
VITE_API_URL=http://localhost:3001
