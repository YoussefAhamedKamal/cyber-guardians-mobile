━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  📍 FIRST TIME SETUP:
  ─────────────────────────────────────────────────────────────────────

  1. Clone the repository:
     git clone https://github.com/YoussefAhamedKamal/cyber-guardians-mobile.git
     cd cyber-guardians-mobile

  2. Install agent dependencies:
     cd cyberguard-agent
     npm install

  3. Set API key (choose one):
     export GEMINI_API_KEY="your-key"

  4. Start agent:
     npm start

  5. In another terminal, start the game:
     cd ..  (back to cyber-guardians-mobile)
     npm install
     npm run dev

  📍 DAILY USAGE (after first setup):
  ─────────────────────────────────────────────────────────────────────

  Terminal 1 (Agent):
    cd ~/cyber-guardians-mobile/cyberguard-agent
    npm start

  Terminal 2 (Game):
    cd ~/cyber-guardians-mobile
    npm run dev

  📍 COMMON COMMANDS:
  ─────────────────────────────────────────────────────────────────────

  # Start with default settings
  cd cyberguard-agent && npm start

  # Start on custom port
  cd cyberguard-agent && npm start -- --port 3002

  # Start with auth token
  cd cyberguard-agent && AGENT_TOKEN=my-secret npm start

  # Start with verbose logging
  cd cyberguard-agent && npm start -- --verbose

  # Check agent status
  cd cyberguard-agent && node bin/cyberguard-agent status

  # List all available tools
  cd cyberguard-agent && node bin/cyberguard-agent tools

