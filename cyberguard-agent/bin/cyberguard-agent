#!/usr/bin/env node

import { createServer } from '../dist/server.js'
import { loadConfig } from '../dist/config.js'

const args = process.argv.slice(2)
const command = args[0]

function printHelp() {
  console.log(`
╔══════════════════════════════════════════════════════════════╗
║  @cyberguard/agent — Multi-Tool Agent System               ║
║  Cyber Guardians Local Agent v2.0.0                        ║
╚══════════════════════════════════════════════════════════════╝

Usage:
  cyberguard-agent start [options]    Start the agent server
  cyberguard-agent status            Show agent status
  cyberguard-agent tools             List available tools
  cyberguard-agent help              Show this help message

Options:
  --port <number>     Server port (default: 3001)
  --token <string>    Auth token (default: empty - no auth)
  --profile <name>    Config profile: minimal|full|education (default: full)
  --verbose           Enable verbose logging

Multi-Tool System:
  Aider (priority)  →  Cline (fallback)  →  Custom Agent (always available)

Supported Tools:
  semgrep, codeql, slither, libfuzzer, skills-discovery
  aider, cline, custom-agent

AI Providers:
  Gemini, Ollama, Groq, HuggingFace, OpenRouter (auto-fallback)

Examples:
  cyberguard-agent start --port 3001 --profile full
  cyberguard-agent start --token my-secret-token
  cyberguard-agent start --verbose
  cyberguard-agent status
  cyberguard-agent tools
`)
}

function getArgValue(flag) {
  const idx = args.indexOf(flag)
  if (idx === -1) return undefined
  const val = args[idx + 1]
  if (val === undefined || val.startsWith('--')) {
    console.error(`Error: ${flag} requires a value`)
    process.exit(1)
  }
  return val
}

async function main() {
  const portStr = getArgValue('--port')
  const token = getArgValue('--token')
  const profile = getArgValue('--profile') || 'full'
  const verbose = args.includes('--verbose')

  const port = portStr ? parseInt(portStr) : 3001
  if (isNaN(port) || port < 1 || port > 65535) {
    console.error(`Error: Invalid port number: ${portStr}`)
    process.exit(1)
  }
  if (!['minimal', 'full', 'education'].includes(profile)) {
    console.error(`Error: Invalid profile '${profile}'. Must be one of: minimal, full, education`)
    process.exit(1)
  }

  switch (command) {
    case 'start': {
      const config = loadConfig({ port, token, profile, verbose })
      const server = createServer(config)
      await server.start()
      break
    }
    case 'status': {
      console.log('Agent status: checking...')
      break
    }
    case 'tools': {
      console.log(`
Available Tools:

  Security Tools:
    semgrep     - Static analysis for many languages
    codeql      - Deep code analysis
    slither     - Solidity smart contract analysis
    libfuzzer   - Coverage-guided fuzzing

  Multi-Tool System:
    aider       - AI-powered coding assistant (priority 1)
    cline       - Alternative AI coding tool (priority 2)
    custom      - Custom agent using AI providers (always available)

  Skills:
    skills-discovery - Find and install skills from marketplace
`)
      break
    }
    case 'help':
    case undefined:
      printHelp()
      break
    default:
      console.error(`Unknown command: ${command}`)
      printHelp()
      process.exit(1)
  }
}

main().catch((err) => {
  console.error('Fatal error:', err)
  process.exit(1)
})
