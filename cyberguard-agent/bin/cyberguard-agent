    list-installs    — List installed skills
    ai-chat          — Chat with AI provider
    file-op          — File operations
    grep             — Content search
    ai-providers     — List AI providers
    task             — Execute complex task (multi-tool)
    tool-status      — Check tool availability
    tool-settings    — Save/load tool settings
    install          — Install package (pip/npm/apt)

