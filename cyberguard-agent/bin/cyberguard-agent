🔧 TROUBLESHOOTING
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ❌ "GEMINI_API_KEY not set"
     → Run: export GEMINI_API_KEY="your-key"
     → Check: echo $GEMINI_API_KEY

  ❌ "Connection refused"
     → Agent not running. Start it: npm start
     → Wrong port? Check: --port flag

  ❌ "npm: command not found"
     → Install Node.js: https://nodejs.org
     → Requires Node 18+

  ❌ "Permission denied"
     → Run with sudo (not recommended)
     → Or fix permissions: sudo chown -R $(whoami) ~/.npm

  ❌ "Ollama not found"
     → Install: curl -fsSL https://ollama.com/install.sh | sh
     → Start: ollama serve

  Still stuck? Check AGENT_GUIDE.md in the project root.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
`)
}

function getArgValue(flag) {
  const idx = args.indexOf(flag)
  if (idx === -1) return undefined
  const val = args[idx + 1]
  if (val === undefined || val.startsWith('--')) {
    console.error(`Error: ${flag} requires a value`)
    process.exit(1)
  }
  return val
}

async function main() {
  const portStr = getArgValue('--port')
  const token = getArgValue('--token')
  const profile = getArgValue('--profile') || 'full'
  const verbose = args.includes('--verbose')

  const port = portStr ? parseInt(portStr) : 3001
  if (isNaN(port) || port < 1 || port > 65535) {
    console.error(`Error: Invalid port number: ${portStr}`)
    process.exit(1)
  }
  if (!['minimal', 'full', 'education'].includes(profile)) {
    console.error(`Error: Invalid profile '${profile}'. Must be one of: minimal, full, education`)
    process.exit(1)
  }

  switch (command) {
    case 'start': {
      const config = loadConfig({ port, token, profile, verbose })
      const server = createServer(config)
      await server.start()
      break
    }
    case 'status': {
      console.log('Agent status: checking...')
      break
    }
    case 'tools': {
      console.log(`
Available Tools:

  Security Tools:
    semgrep     - Static analysis for many languages
    codeql      - Deep code analysis
    slither     - Solidity smart contract analysis
    libfuzzer   - Coverage-guided fuzzing

  Multi-Tool System:
    aider       - AI-powered coding assistant (priority 1)
    cline       - Alternative AI coding tool (priority 2)
    custom      - Custom agent using AI providers (always available)

  Skills:
    skills-discovery - Find and install skills from marketplace
`)
      break
    }
    case 'help':
    case undefined:
      printHelp()
      break
    default:
      console.error(`Unknown command: ${command}`)
      printHelp()
      process.exit(1)
  }
}

main().catch((err) => {
  console.error('Fatal error:', err)
  process.exit(1)
})
